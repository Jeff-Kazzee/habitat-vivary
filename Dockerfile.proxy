FROM docker.io/library/ubuntu@sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates=20260816ubuntu0.24.04.1 \
      squid=6.14-0ubuntu0.24.04.4 \
      tzdata=2026c-0ubuntu0.24.04.1 \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/squid/conf.d/debian.conf

COPY squid.conf /etc/squid/squid.conf

EXPOSE 3128

USER proxy

CMD ["/usr/sbin/squid", "-N", "-d", "1"]
