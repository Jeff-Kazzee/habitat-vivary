FROM docker.io/library/ubuntu@sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG DEBIAN_FRONTEND=noninteractive
ARG MISE_VERSION=2026.7.13
ARG MISE_SHA256=c906aa3e764f6a693beb4005d9a89edde7b4edb60d0733bbdccbbcee3b982081
ARG NODE_VERSION=22.23.4
ARG PYTHON_VERSION=3.11.16
ARG PNPM_VERSION=11.23.0
ARG CODEX_VERSION=0.143.0
ARG CLAUDE_CODE_VERSION=2.1.241
ARG VARLOCK_VERSION=1.17.0

# Reject ARG overrides before any runtime download or dependency execution.
RUN test "${NODE_VERSION}" = "22.23.4"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates=20260816ubuntu0.24.04.1 \
      curl=8.5.0-2ubuntu10.13 \
      git=1:2.43.0-1ubuntu7.3 \
      jq=1.7.1-3ubuntu0.24.04.2 \
      less=590-2ubuntu2.1 \
      openssh-client=1:9.6p1-3ubuntu13.18 \
      ripgrep=14.1.0-1 \
      tzdata=2026c-0ubuntu0.24.04.1 \
      xz-utils=5.6.1+really5.4.5-1ubuntu0.3 \
    && rm -rf /var/lib/apt/lists/*

# Official Linux x64 archive. Refresh the version and checksum together.
RUN curl -fsSL --proto '=https' --tlsv1.2 \
      "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
      -o /tmp/node.tar.xz \
    && echo "1805bcd35e6815559bd2eb97db438d3fdb0eb3a5e6a977b7c1badca76337e9ce  /tmp/node.tar.xz" | sha256sum --check --strict \
    && tar -xJf /tmp/node.tar.xz --strip-components=1 -C /usr/local \
    && rm /tmp/node.tar.xz \
    && test "$(node --version)" = "v${NODE_VERSION}"

COPY scripts/check-node-security.py /usr/local/lib/habitat/check-node-security.py
COPY scripts/habitat-entrypoint.sh /usr/local/bin/habitat-entrypoint

RUN curl -fsSL --tlsv1.2 \
      "https://github.com/jdx/mise/releases/download/v${MISE_VERSION}/mise-v${MISE_VERSION}-linux-x64.tar.xz" \
      -o /tmp/mise.tar.xz \
    && echo "${MISE_SHA256}  /tmp/mise.tar.xz" | sha256sum --check --strict \
    && tar -xJf /tmp/mise.tar.xz \
      --strip-components=2 \
      -C /usr/local/bin \
      mise/bin/mise \
    && rm /tmp/mise.tar.xz \
    && mise --version

RUN install -d -o ubuntu -g ubuntu \
      /home/ubuntu/.claude \
      /home/ubuntu/.codex \
      /home/ubuntu/.config \
      /home/ubuntu/.config/varlock \
      /home/ubuntu/.local/share/mise \
      /home/ubuntu/.local/share/pnpm \
      /home/ubuntu/.local/share/pnpm/bin \
      /home/ubuntu/.local/state/mise \
      /workspace \
    && chown -R ubuntu:ubuntu \
      /home/ubuntu/.config \
      /home/ubuntu/.local \
      /workspace

ENV HOME=/home/ubuntu \
    MISE_DATA_DIR=/home/ubuntu/.local/share/mise \
    MISE_CONFIG_DIR=/home/ubuntu/.config/mise \
    MISE_YES=1 \
    PNPM_HOME=/home/ubuntu/.local/share/pnpm \
    DISABLE_AUTOUPDATER=1 \
    DO_NOT_TRACK=1 \
    PATH=/home/ubuntu/.local/share/mise/shims:/home/ubuntu/.local/share/pnpm/bin:/home/ubuntu/.local/share/pnpm:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

USER ubuntu

RUN mise use --global "python@${PYTHON_VERSION}" \
    && mise reshim \
    && test "$(node --version)" = "v${NODE_VERSION}" \
    && test "$(python --version)" = "Python ${PYTHON_VERSION}" \
    && python /usr/local/lib/habitat/check-node-security.py

RUN corepack enable --install-directory "${PNPM_HOME}/bin" \
    && corepack prepare "pnpm@${PNPM_VERSION}" --activate \
    && mise reshim \
    && test "$(pnpm --version)" = "${PNPM_VERSION}" \
    && pnpm config set minimumReleaseAge 10080 --global \
    && pnpm config set minimumReleaseAgeStrict true --global \
    && pnpm config set blockExoticSubdeps true --global

RUN pnpm add --global \
      --allow-build=@anthropic-ai/claude-code \
      "@openai/codex@${CODEX_VERSION}" \
      "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
      "varlock@${VARLOCK_VERSION}" \
    && test "$(codex --version)" = "codex-cli ${CODEX_VERSION}" \
    && test "$(claude --version)" = "${CLAUDE_CODE_VERSION} (Claude Code)" \
    && test "$(varlock --version)" = "${VARLOCK_VERSION}"

WORKDIR /workspace

ENTRYPOINT ["/bin/bash", "/usr/local/bin/habitat-entrypoint"]
CMD ["/bin/bash"]
